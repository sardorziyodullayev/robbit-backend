PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database driver tanlash: "sqlite" (lokal demo) yoki "postgres" (production)
DB_DRIVER=postgres

# SQLite ishlatish uchun (DB_DRIVER=sqlite):
DB_PATH=./robbit.sqlite

# Postgres ishlatish uchun (DB_DRIVER=postgres):
DB_HOST=localhost
DB_PORT=5432
DB_USER=robbit
DB_PASS=robbit
DB_NAME=robbit
DB_SSL=false
DB_SYNC=true

# Yoki bitta connection string (Railway/Render/Supabase/Neon shu turdagi URL beradi):
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DB_SSL=true  # managed Postgres uchun majburiy

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
UPLOAD_DIR=./uploads
PUBLIC_URL=http://localhost:4000
SEED_ON_START=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@robbit.local
ADMIN_PASSWORD=Admin@123
